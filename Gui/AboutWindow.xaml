<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_AboutTitle}"
        Width="640" Height="740" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}">

  <Window.Resources>
    <!-- Light values; Show-Screen4ScreenGui.ps1 swaps them to match the main
         window's current theme before this one is shown. -->
    <SolidColorBrush x:Key="WindowBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#F5F6F7"/>
    <SolidColorBrush x:Key="FieldBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush2"     Color="#D9DCE0"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#1A1C1E"/>
    <SolidColorBrush x:Key="SubtleBrush"      Color="#5A6068"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#B0296A"/>
    <SolidColorBrush x:Key="OnAccentBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThumbBrush"       Color="#E8EAEC"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#E8EAEC"/>
    <SolidColorBrush x:Key="PressedBrush"     Color="#DCDFE3"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C8CD"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- The app name. TextFormattingMode Ideal, not the Display the implicit
         style sets: Display snaps glyphs to the pixel grid, which is right for
         13px UI text and thins a 20px semibold heading until it reads as grey
         rather than white. Measured on a dark render: the strokes lost most of
         their coverage. -->
    <Style x:Key="Title1" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- The sentence under the name, and the version beside it. -->
    <Style x:Key="Lead" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,14,0,0"/>
      <Setter Property="LineHeight" Value="19"/>
    </Style>

    <Style x:Key="Meta" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <!-- Each section is a card, the same shape the main window uses for the
         automation box, so the two read as one family. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16,14,16,8"/>
      <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,11"/>
    </Style>

    <!-- A dot in the accent colour and the text beside it, wrapping under
         itself rather than under the dot. Written as a template so each item
         below stays one line of markup. -->
    <Style x:Key="Bullet" TargetType="ContentControl">
      <Setter Property="Margin" Value="0,0,0,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Ellipse Width="5" Height="5" Margin="1,7,11,0" VerticalAlignment="Top"
                       Fill="{DynamicResource AccentBrush}"/>
              <ContentPresenter Grid.Column="1"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The three file paths, set into the card so they read as data. -->
    <Style x:Key="Inset" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThumbBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="16,2,0,9"/>
    </Style>

    <Style x:Key="Path2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>

    <Style x:Key="LinkRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" Padding="2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="26,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="19" Background="{TemplateBinding Background}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="3,0"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Rectangle Grid.Row="0" Height="3">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#98C7BF" Offset="0.0"/>
          <GradientStop Color="#E2ABBA" Offset="0.25"/>
          <GradientStop Color="#A890C0" Offset="0.50"/>
          <GradientStop Color="#8CC6E6" Offset="0.75"/>
          <GradientStop Color="#F7F19F" Offset="1.0"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,22,26,22">
      <StackPanel>

        <!-- Identity: the same icon Explorer and the taskbar show, so the
             window says what it belongs to before it says anything else.
             The source is set from the code, which knows where the file is. -->
        <StackPanel Orientation="Horizontal">
          <Image x:Name="ImgLogo" Width="46" Height="46" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="screen4screen" Style="{StaticResource Title1}"/>
            <TextBlock x:Name="TxtVersion" Style="{StaticResource Meta}"/>
          </StackPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource Lead}" Text="{DynamicResource S_AboutIntro}"/>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="{DynamicResource S_AboutChangesHeading}"/>
            <ContentControl Style="{StaticResource Bullet}">
              <TextBlock Text="{DynamicResource S_AboutChanges1}"/>
            </ContentControl>
            <ContentControl Style="{StaticResource Bullet}">
              <TextBlock Text="{DynamicResource S_AboutChanges2}"/>
            </ContentControl>
            <ContentControl Style="{StaticResource Bullet}">
              <TextBlock Text="{DynamicResource S_AboutFilesIntro}"/>
            </ContentControl>
            <Border Style="{StaticResource Inset}">
              <StackPanel>
                <TextBlock Style="{StaticResource Path2}" Text="%LOCALAPPDATA%\screen4screen\log.txt"/>
                <TextBlock Style="{StaticResource Path2}" Text="%LOCALAPPDATA%\screen4screen\gui-settings.json"/>
                <TextBlock Style="{StaticResource Path2}" Text="{DynamicResource S_AboutFile3}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="{DynamicResource S_AboutNotHeading}"/>
            <ContentControl Style="{StaticResource Bullet}">
              <TextBlock Text="{DynamicResource S_AboutNot1}"/>
            </ContentControl>
            <ContentControl Style="{StaticResource Bullet}">
              <TextBlock Text="{DynamicResource S_AboutNot2}"/>
            </ContentControl>
            <ContentControl Style="{StaticResource Bullet}">
              <TextBlock Text="{DynamicResource S_AboutNot3}"/>
            </ContentControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="{DynamicResource S_AboutSpotlightHeading}"/>
            <ContentControl Style="{StaticResource Bullet}">
              <TextBlock Text="{DynamicResource S_AboutSpotlight}"/>
            </ContentControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- A rule above the footer, or the scrolled text runs straight into the
         button with nothing to say where the page ends. The link sits on the
         left, where it is seen, instead of last in the scroll. -->
    <Border Grid.Row="2" Padding="26,14" Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="BtnClose" IsDefault="True"
                Content="{DynamicResource S_CloseLabel}"/>
        <Button x:Name="BtnGithub" Style="{StaticResource LinkRow}" VerticalAlignment="Center"
                ToolTip="{DynamicResource S_GithubTip}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="15" Height="15" VerticalAlignment="Center">
              <Canvas Width="16" Height="16">
                <Path Fill="{DynamicResource SubtleBrush}"
                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="github.com/pmudry/screen4screen" Margin="9,0,0,0"
                       FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubtleBrush}"/>
          </StackPanel>
        </Button>
      </DockPanel>
    </Border>
  </Grid>
</Window>
