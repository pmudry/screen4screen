<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S_AboutTitle}"
        Width="560" Height="520" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}">

  <Window.Resources>
    <!-- Light values; Show-Screen4ScreenGui.ps1 swaps them to match the main
         window's current theme before this one is shown. -->
    <SolidColorBrush x:Key="WindowBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#F5F6F7"/>
    <SolidColorBrush x:Key="FieldBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush2"     Color="#D9DCE0"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#1A1C1E"/>
    <SolidColorBrush x:Key="SubtleBrush"      Color="#5A6068"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#B0296A"/>
    <SolidColorBrush x:Key="OnAccentBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThumbBrush"       Color="#E8EAEC"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#E8EAEC"/>
    <SolidColorBrush x:Key="PressedBrush"     Color="#DCDFE3"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C8CD"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,18,0,6"/>
    </Style>

    <Style x:Key="Item" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>

    <Style x:Key="Path2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <Style x:Key="LinkRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" Padding="2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="26,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="19" Background="{TemplateBinding Background}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="3,0"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Rectangle Grid.Row="0" Height="3">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#98C7BF" Offset="0.0"/>
          <GradientStop Color="#E2ABBA" Offset="0.25"/>
          <GradientStop Color="#A890C0" Offset="0.50"/>
          <GradientStop Color="#8CC6E6" Offset="0.75"/>
          <GradientStop Color="#F7F19F" Offset="1.0"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
      <StackPanel>

        <TextBlock Text="screen4screen" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SubtleBrush}"
                   Text="{DynamicResource S_AboutIntro}"/>

        <TextBlock Style="{StaticResource H2}" Text="{DynamicResource S_AboutChangesHeading}"/>
        <TextBlock Style="{StaticResource Item}" Text="{DynamicResource S_AboutChanges1}"/>
        <TextBlock Style="{StaticResource Item}" Text="{DynamicResource S_AboutChanges2}"/>
        <TextBlock Style="{StaticResource Item}" Text="{DynamicResource S_AboutFilesIntro}"/>
        <TextBlock Style="{StaticResource Path2}" Text="%LOCALAPPDATA%\screen4screen\log.txt"/>
        <TextBlock Style="{StaticResource Path2}" Text="%LOCALAPPDATA%\screen4screen\gui-settings.json"/>
        <TextBlock Style="{StaticResource Path2}" Text="{DynamicResource S_AboutFile3}"/>

        <TextBlock Style="{StaticResource H2}" Text="{DynamicResource S_AboutNotHeading}"/>
        <TextBlock Style="{StaticResource Item}" Text="{DynamicResource S_AboutNot1}"/>
        <TextBlock Style="{StaticResource Item}" Text="{DynamicResource S_AboutNot2}"/>
        <TextBlock Style="{StaticResource Item}" Text="{DynamicResource S_AboutNot3}"/>

        <TextBlock Style="{StaticResource H2}" Text="{DynamicResource S_AboutSpotlightHeading}"/>
        <TextBlock Style="{StaticResource Item}" Text="{DynamicResource S_AboutSpotlight}"/>

        <TextBlock x:Name="TxtVersion" Margin="0,20,0,0" FontSize="12"
                   Foreground="{DynamicResource SubtleBrush}"/>

        <Button x:Name="BtnGithub" Style="{StaticResource LinkRow}" Margin="0,6,0,0"
                ToolTip="{DynamicResource S_GithubTip}">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="15" Height="15" VerticalAlignment="Center">
              <Canvas Width="16" Height="16">
                <Path Fill="{DynamicResource SubtleBrush}"
                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="github.com/pmudry/screen4screen" Margin="8,0,0,0"
                       FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubtleBrush}"/>
          </StackPanel>
        </Button>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="24,14">
      <Button x:Name="BtnClose" Content="{DynamicResource S_CloseLabel}" HorizontalAlignment="Right" IsDefault="True"/>
    </Border>
  </Grid>
</Window>
