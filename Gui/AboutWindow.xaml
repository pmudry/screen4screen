<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ce que fait ce programme"
        Width="640" Height="660" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}">

  <Window.Resources>
    <!-- Light values; Show-WallpaperGui.ps1 swaps them to match the main
         window's current theme before this one is shown. -->
    <SolidColorBrush x:Key="WindowBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#F5F6F7"/>
    <SolidColorBrush x:Key="FieldBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush2"     Color="#D9DCE0"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#1A1C1E"/>
    <SolidColorBrush x:Key="SubtleBrush"      Color="#5A6068"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#B0296A"/>
    <SolidColorBrush x:Key="OnAccentBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThumbBrush"       Color="#E8EAEC"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#E8EAEC"/>
    <SolidColorBrush x:Key="PressedBrush"     Color="#DCDFE3"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C8CD"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,18,0,6"/>
    </Style>

    <Style x:Key="Item" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>

    <Style x:Key="Path2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="20,8"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" Margin="3,0"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Rectangle Grid.Row="0" Height="3">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#98C7BF" Offset="0.0"/>
          <GradientStop Color="#E2ABBA" Offset="0.25"/>
          <GradientStop Color="#A890C0" Offset="0.50"/>
          <GradientStop Color="#8CC6E6" Offset="0.75"/>
          <GradientStop Color="#F7F19F" Offset="1.0"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
      <StackPanel>

        <TextBlock Text="Fonds d'écran par écran" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SubtleBrush}"
                   Text="Chaque écran reçoit une image faite pour sa résolution, au lieu d'une seule image étirée ou recadrée sur tous. Quand vous branchez, débranchez ou changez d'écran, les fonds se remettent en place."/>

        <TextBlock Style="{StaticResource H2}" Text="Comment il choisit l'image"/>
        <TextBlock Style="{StaticResource Item}"
                   Text="Il lit la résolution réelle de chaque écran, en pixels, indépendamment du facteur d'agrandissement de Windows. Il cherche ensuite dans votre dossier d'images un fichier au nom de cette résolution (par exemple 3840x2160), sinon un fichier au nom du format de l'écran (ratio-16x9), sinon un fichier nommé default. Vous pouvez aussi imposer une image précise à un écran donné."/>

        <TextBlock Style="{StaticResource H2}" Text="Ce qu'il modifie sur votre ordinateur"/>

        <TextBlock Style="{StaticResource Item}"
                   Text="Votre fond d'écran, par l'interface prévue par Windows pour ça. Rien d'autre n'est touché dans vos réglages d'affichage."/>

        <TextBlock Style="{StaticResource Item}"
                   Text="Si vous activez le changement automatique : une tâche planifiée nommée WallpaperByResolution, qui démarre à votre ouverture de session. Elle tourne sous votre compte, sans droits administrateur, et vérifie vos écrans toutes les trois secondes. La désactiver la supprime complètement."/>

        <TextBlock Style="{StaticResource Item}" Text="Un journal de ce qu'il fait :"/>
        <TextBlock Style="{StaticResource Path2}" Text="%LOCALAPPDATA%\WallpaperByResolution\log.txt"/>

        <TextBlock Style="{StaticResource Item}" Margin="0,12,0,0"
                   Text="Les réglages de cette fenêtre, à côté du journal :"/>
        <TextBlock Style="{StaticResource Path2}" Text="%LOCALAPPDATA%\WallpaperByResolution\gui-settings.json"/>

        <TextBlock Style="{StaticResource Item}" Margin="0,12,0,0"
                   Text="Les images que vous imposez à un écran, dans votre dossier d'images :"/>
        <TextBlock Style="{StaticResource Path2}" Text="wallpapers.json"/>

        <TextBlock Style="{StaticResource H2}" Text="Ce qu'il ne fait pas"/>
        <TextBlock Style="{StaticResource Item}"
                   Text="Aucune connexion à Internet, aucune donnée envoyée où que ce soit."/>
        <TextBlock Style="{StaticResource Item}"
                   Text="Vos images ne sont jamais modifiées, déplacées ni supprimées : elles sont seulement lues."/>
        <TextBlock Style="{StaticResource Item}"
                   Text="Aucun droit administrateur n'est demandé, et rien n'est écrit en dehors de votre compte utilisateur."/>
        <TextBlock Style="{StaticResource Item}"
                   Text="Aucun programme n'est installé : tout tient dans les fichiers du dossier d'où vous l'avez lancé."/>

        <TextBlock Style="{StaticResource H2}" Text="Si vos fonds d'écran reviennent tout seuls"/>
        <TextBlock Style="{StaticResource Item}"
                   Text="C'est en général Windows Spotlight ou le diaporama de fonds d'écran, qui remettent leurs propres images. Désactivez-les dans Paramètres, Personnalisation, Arrière-plan."/>

        <TextBlock Style="{StaticResource H2}" Text="Pour tout retirer"/>
        <TextBlock Style="{StaticResource Item}"
                   Text="Désactivez le changement automatique, puis supprimez le dossier du programme. Vous pouvez aussi effacer le dossier WallpaperByResolution dans %LOCALAPPDATA% pour le journal et les réglages."/>

        <TextBlock Margin="0,20,0,0" Foreground="{DynamicResource SubtleBrush}" FontSize="12"
                   Text="github.com/pmudry/wallpaper-by-resolution"/>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="24,14">
      <Button x:Name="BtnClose" Content="Fermer" HorizontalAlignment="Right" IsDefault="True"/>
    </Border>
  </Grid>
</Window>
