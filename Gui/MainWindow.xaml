<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="screen4screen"
        Width="820" Height="640" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}">

  <Window.Resources>

    <!-- Every user-facing string lives in Lang\<code>.xaml, merged into
         these resources at startup and swapped when the language changes.
         Neither this file nor the ASCII-only .ps1 host carries display
         text any more, which is what lets the window speak four languages
         while the host stays readable under Windows PowerShell 5.1.
         Refer to a string with DynamicResource, never Static: only
         DynamicResource re-resolves when the dictionary is swapped. -->

    <!-- Light values. Show-Screen4ScreenGui.ps1 replaces every one of these when
         Windows is in dark mode, which is why nothing below uses
         StaticResource for a colour: only DynamicResource re-resolves. -->
    <!-- The page is faintly grey and every surface on it is white. With
         both white, the drop-down was indistinguishable from the window
         behind it and looked like it had no background at all. -->
    <SolidColorBrush x:Key="WindowBrush"      Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush2"     Color="#D9DCE0"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#1A1C1E"/>
    <SolidColorBrush x:Key="SubtleBrush"      Color="#5A6068"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#B0296A"/>
    <SolidColorBrush x:Key="OnAccentBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThumbBrush"       Color="#E8EAEC"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#EBEDEF"/>
    <SolidColorBrush x:Key="PressedBrush"     Color="#DFE2E6"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C8CD"/>
    <SolidColorBrush x:Key="FabBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FabEdgeBrush"     Color="#D9DCE0"/>
    <SolidColorBrush x:Key="FabIconBrush"     Color="#1A1C1E"/>
    <SolidColorBrush x:Key="PopupBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PopupEdgeBrush"   Color="#AEB4BC"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Subtle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,7"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="18"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="24,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="19"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The circular control used across the ISC sites: 44 px, round,
         a soft shadow, and a lift on hover. WPF has no backdrop blur, so the
         glass effect is approximated with a flat translucent surface. -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{DynamicResource FabBrush}"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="Bd" Fill="{TemplateBinding Background}"
                       Stroke="{DynamicResource FabEdgeBrush}" StrokeThickness="1">
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                    Opacity="0.22" Color="#000000"/>
                </Ellipse.Effect>
              </Ellipse>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="1.1" ScaleY="1.1"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One line of the language menu. Left-aligned and full width, so the
         four entries read as a list rather than as four little buttons. -->
    <Style x:Key="LangItem" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="6" SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <!-- No Margin="{TemplateBinding Padding}" here: TextBoxBase
                   already pushes its Padding onto PART_ContentHost, so
                   binding it again applied it twice and the path sat 27px
                   from the border while the drop-down below sat at 15. -->
              <ScrollViewer x:Name="PART_ContentHost"
                            VerticalAlignment="Center"
                            Background="Transparent"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ComboBox is fully templated: the stock template paints its own Aero
         chrome and ignores Background, which left a white drop-down button
         sitting in a dark window. -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="6" SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    Background="{DynamicResource FieldBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}"
                    BorderThickness="1">
              <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,11,0" Data="M 0 0 L 4 4 L 8 0"
                    Stroke="{DynamicResource SubtleBrush}" StrokeThickness="1.4"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}"
                            Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                        RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                Margin="15,0,32,0" VerticalAlignment="Center"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                     VerticalOffset="4" AllowsTransparency="True" PopupAnimation="Fade"
                     IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <!-- No Margin and no shadow here on purpose. A margin leaves
                     part of the popup window unpainted, and that area comes
                     out white rather than transparent, which showed as a band
                     under the list. The border carries the separation instead. -->
                <Border CornerRadius="6" Padding="0,4" SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{DynamicResource PopupBrush}"
                        BorderBrush="{DynamicResource PopupEdgeBrush}" BorderThickness="1">
                  <ScrollViewer Background="Transparent">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Margin="3,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Drawn as a switch: turning the automation on or off is an on/off
         thing, not a form field. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                      VerticalAlignment="Center"
                      Background="{DynamicResource BorderBrush2}">
                <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3,0,0,0"
                         HorizontalAlignment="Left"
                         Fill="{DynamicResource WindowBrush}"/>
              </Border>
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccentBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
              </Trigger>
              <!-- The switch is disabled while the task is being registered.
                   Without this it went on looking perfectly live. -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                <Setter TargetName="Knob" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The stock scrollbar stays light grey over a dark surface. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource ScrollThumbBrush}"
                    CornerRadius="3" Margin="3,0"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollTrackButton}"
                                Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollTrackButton}"
                                Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One card per monitor. Row buttons carry their verb in Tag and are
         handled by a single class handler on the ItemsControl. -->
    <DataTemplate x:Key="DisplayTemplate">
      <Border Margin="0,0,0,8" Padding="12" CornerRadius="5"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Fixed 150x54 slot so every row lines up, with the preview
               itself drawn at the screen's own proportions inside it. -->
          <!-- Centred vertically: the action button sits under the text, so a
               top-aligned preview reads as misaligned against the card. -->
          <Grid Grid.Column="0" Width="150" Height="54" VerticalAlignment="Center">
            <Border Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}"
                    CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ThumbBrush}" ClipToBounds="True">
              <Image Source="{Binding Thumbnail}" Stretch="Fill"/>
            </Border>
          </Grid>

          <StackPanel Grid.Column="1" Margin="14,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Friendly}" FontWeight="SemiBold" FontSize="14"
                         Foreground="{DynamicResource TextBrush}"
                         TextTrimming="CharacterEllipsis"/>
              <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                      Padding="7,2" Margin="10,0,0,0"
                      Visibility="{Binding BadgeVisibility}">
                <TextBlock Text="{DynamicResource S_PrimaryBadge}" FontSize="11"
                           Foreground="{DynamicResource OnAccentBrush}"/>
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding ResolutionText}" Style="{StaticResource Subtle}"
                       Margin="0,2,0,0"/>

            <TextBlock Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextBrush}"
                       ToolTip="{Binding ImagePath}">
              <Run Text="{Binding ImageText, Mode=OneWay}"
                   Foreground="{DynamicResource TextBrush}"/>
              <Run Text="{Binding SourceText, Mode=OneWay}"
                   Foreground="{DynamicResource SubtleBrush}"/>
            </TextBlock>

            <TextBlock Text="{Binding ProblemText}" Margin="0,4,0,0"
                       Foreground="{DynamicResource AccentBrush}" FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding ProblemVisibility}"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Tag="pick" Content="{Binding PickLabel}"/>
              <Button Tag="auto" Content="{DynamicResource S_AutoLabel}" Margin="8,0,0,0"
                      Visibility="{Binding AutoVisibility}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Rectangle Grid.Row="0" Height="3">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#98C7BF" Offset="0.0"/>
          <GradientStop Color="#E2ABBA" Offset="0.25"/>
          <GradientStop Color="#A890C0" Offset="0.50"/>
          <GradientStop Color="#8CC6E6" Offset="0.75"/>
          <GradientStop Color="#F7F19F" Offset="1.0"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <DockPanel Grid.Row="1" Margin="20,16,20,0">
      <Button DockPanel.Dock="Right" x:Name="BtnAbout" Margin="8,0,0,0"
              Style="{StaticResource IconButton}" VerticalAlignment="Top"
              AutomationProperties.Name="{DynamicResource S_AboutName}"
              ToolTip="{DynamicResource S_AboutTip}">
        <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource FabIconBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>

      <!-- The button and its menu share a Grid: a Popup takes no room in the
           layout, but DockPanel would still give it a slot of its own.
           The 8px left margin is what every right-docked circle needs: on a
           DockPanel the margin opens the gap towards the next one along, so
           leaving it off here made this one sit flush against the theme
           switch while the other gap was 8. -->
      <Grid DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top">
        <Button x:Name="BtnLang" Style="{StaticResource IconButton}"
                AutomationProperties.Name="{DynamicResource S_LangName}"
                ToolTip="{DynamicResource S_LangTip}">
          <!-- Set from the code to the current two-letter code. -->
          <TextBlock x:Name="TxtLang" Text="FR" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource FabIconBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <!-- The names are endonyms and stay as they are in every language. -->
        <Popup x:Name="PopLang" PlacementTarget="{Binding ElementName=BtnLang}"
               Placement="Bottom" HorizontalOffset="-40" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
          <Border CornerRadius="6" Padding="4" SnapsToDevicePixels="True"
                  Background="{DynamicResource PopupBrush}"
                  BorderBrush="{DynamicResource PopupEdgeBrush}" BorderThickness="1">
            <StackPanel MinWidth="132">
              <Button Tag="fr" Content="Français" Style="{StaticResource LangItem}"/>
              <Button Tag="en" Content="English"  Style="{StaticResource LangItem}"/>
              <Button Tag="de" Content="Deutsch"  Style="{StaticResource LangItem}"/>
              <Button Tag="it" Content="Italiano" Style="{StaticResource LangItem}"/>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- ToolTip maps to UIA HelpText, not Name, so an icon-only button is
           announced as nothing at all without this. The tooltip itself is set
           from the code, which knows which way the switch will go. -->
      <Button DockPanel.Dock="Right" x:Name="BtnTheme"
              Style="{StaticResource IconButton}" VerticalAlignment="Top"
              AutomationProperties.Name="{DynamicResource S_ThemeName}">
        <Grid>
          <!-- Feather-style strokes on a 24x24 grid, the same shapes the ISC
               sites use, scaled down by the Viewbox. -->
          <Viewbox x:Name="IconMoon" Width="16" Height="16">
            <Canvas Width="24" Height="24">
              <Path Stroke="{DynamicResource FabIconBrush}" StrokeThickness="2"
                    StrokeLineJoin="Round"
                    Data="M21,12.79 A9,9 0 1,1 11.21,3 A7,7 0 0,0 21,12.79 Z"/>
            </Canvas>
          </Viewbox>
          <Viewbox x:Name="IconSun" Width="16" Height="16" Visibility="Collapsed">
            <Canvas Width="24" Height="24">
              <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8"
                       Stroke="{DynamicResource FabIconBrush}" StrokeThickness="2"/>
              <Path Stroke="{DynamicResource FabIconBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M12,2 V4 M12,20 V22 M4.93,4.93 L6.34,6.34 M17.66,17.66 L19.07,19.07 M2,12 H4 M20,12 H22 M4.93,19.07 L6.34,17.66 M17.66,6.34 L19.07,4.93"/>
            </Canvas>
          </Viewbox>
        </Grid>
      </Button>
      <StackPanel>
        <TextBlock Text="screen4screen" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource S_Tagline}"
                   Style="{StaticResource Subtle}" Margin="0,2,0,0"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="2" Margin="20,18,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S_FolderLabel}"
                 VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtRoot"
                 VerticalAlignment="Center"/>
      <Button    Grid.Row="0" Grid.Column="2" x:Name="BtnBrowse" Content="{DynamicResource S_BrowseLabel}"
                 Margin="8,0,0,0"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource S_PositionLabel}"
                 VerticalAlignment="Center" Margin="0,10,12,0"/>
      <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="CmbPosition" Margin="0,10,0,0"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Left" MinWidth="300">
        <ComboBoxItem Tag="Fill"    Content="{DynamicResource S_PosFill}"/>
        <ComboBoxItem Tag="Fit"     Content="{DynamicResource S_PosFit}"/>
        <ComboBoxItem Tag="Stretch" Content="{DynamicResource S_PosStretch}"/>
        <ComboBoxItem Tag="Center"  Content="{DynamicResource S_PosCenter}"/>
        <ComboBoxItem Tag="Tile"    Content="{DynamicResource S_PosTile}"/>
        <ComboBoxItem Tag="Span"    Content="{DynamicResource S_PosSpan}"/>
      </ComboBox>
    </Grid>

    <Grid Grid.Row="3" Margin="20,18,20,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="{DynamicResource S_RefreshLabel}"/>
        <TextBlock Text="{DynamicResource S_ScreensHeading}" Style="{StaticResource SectionTitle}"
                   VerticalAlignment="Center"/>
      </DockPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="LstDisplays"
                      ItemTemplate="{StaticResource DisplayTemplate}"/>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="4" Margin="20,16,20,0" Padding="14,12" CornerRadius="5"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
      <StackPanel>
        <CheckBox x:Name="TglAuto" FontWeight="SemiBold"
                  Content="{DynamicResource S_AutoToggle}"
                  ToolTip="{DynamicResource S_AutoToggleTip}"/>
        <TextBlock x:Name="TxtAutoState" Style="{StaticResource Subtle}"
                   Margin="52,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <DockPanel Grid.Row="5" Margin="20,16,20,18">
      <Button DockPanel.Dock="Right" x:Name="BtnApply" Content="{DynamicResource S_ApplyLabel}"
              Style="{StaticResource AccentButton}" IsDefault="True"/>
      <Button DockPanel.Dock="Right" x:Name="BtnLog" Content="{DynamicResource S_LogLabel}"
              Style="{StaticResource LinkButton}" Margin="0,0,10,0"
              ToolTip="{DynamicResource S_LogTip}"/>
      <!-- Declared after the log link, so it lands to its left: a DockPanel
           gives the first right-docked child the rightmost slot. Hidden while
           there is no task to show. Windows offers no way to open the Task
           Scheduler on a particular task, so this just opens it; ours sits in
           the root folder under its own name. -->
      <Button DockPanel.Dock="Right" x:Name="BtnTask" Content="{DynamicResource S_ShowTaskLabel}"
              Style="{StaticResource LinkButton}" Margin="0,0,10,0" Visibility="Collapsed"
              ToolTip="{DynamicResource S_ShowTaskTip}"/>
      <TextBlock x:Name="TxtStatus" VerticalAlignment="Center"
                 Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
    </DockPanel>

  </Grid>
</Window>
