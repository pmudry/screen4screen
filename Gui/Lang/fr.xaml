<?xml version="1.0" encoding="utf-8"?>
<!-- French strings for the screen4screen window.

     Every user-facing string lives in one of these files, never in the code.
     The window merges the chosen one into its resources and refers to each
     string with {DynamicResource}, so switching language re-renders the
     window in place. Keep the keys identical across all four files: the
     window falls back to English for a key that is missing.

     UTF-8, and the XML declaration above says so, which is why accented text
     is safe here and not in the .ps1 files. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <sys:String x:Key="S_Applying">Application en cours...</sys:String>
  <sys:String x:Key="S_Applied">{0} écran(s) mis à jour.</sys:String>
  <sys:String x:Key="S_AppliedPartial">{0} écran(s) sur {1} mis à jour. Détails dans le journal.</sys:String>
  <sys:String x:Key="S_Saved">Réglages enregistrés.</sys:String>
  <sys:String x:Key="S_TopologyChanged">Vos écrans ont changé, la liste est à jour.</sys:String>
  <sys:String x:Key="S_TopologyChangedIdle">Vos écrans ont changé. Cliquez « Appliquer maintenant ».</sys:String>
  <sys:String x:Key="S_FolderMissing">Ce dossier n'existe pas.</sys:String>
  <sys:String x:Key="S_NoDisplay">Aucun écran détecté. Essayez « Actualiser ».</sys:String>
  <sys:String x:Key="S_AutoOn">Actif : vos fonds d'écran suivront vos écrans.</sys:String>
  <sys:String x:Key="S_AutoOff">Inactif : les fonds d'écran ne changeront plus tout seuls.</sys:String>
  <sys:String x:Key="S_AutoPaused">En pause : ça reprendra à votre prochaine ouverture de session.</sys:String>
  <sys:String x:Key="S_AutoFailed">Impossible de changer ce réglage. Détails dans le journal.</sys:String>
  <sys:String x:Key="S_Error">Une erreur est survenue. Détails dans le journal.</sys:String>
  <sys:String x:Key="S_PickTitle">Choisissez une image pour cet écran</sys:String>
  <sys:String x:Key="S_BrowseTitle">Choisissez le dossier qui contient vos images.</sys:String>
  <sys:String x:Key="S_SourceAuto">(choisie automatiquement)</sys:String>
  <sys:String x:Key="S_SourceManual">(votre choix)</sys:String>
  <sys:String x:Key="S_NoImage">Aucune image ne correspond à cet écran.</sys:String>
  <sys:String x:Key="S_NoThumb">Aperçu impossible pour ce format d'image.</sys:String>
  <sys:String x:Key="S_NotMatched">Windows ne distingue pas cet écran ; l'image sera appliquée partout.</sys:String>
  <sys:String x:Key="S_PickLabel">Choisir une image...</sys:String>
  <sys:String x:Key="S_ChangeLabel">Changer...</sys:String>
  <sys:String x:Key="S_LoadingPreviews">Chargement des aperçus...</sys:String>
  <sys:String x:Key="S_Working">Un instant...</sys:String>
  <sys:String x:Key="S_ThemeToDark">Passer à l'apparence sombre</sys:String>
  <sys:String x:Key="S_ThemeToLight">Passer à l'apparence claire</sys:String>
  <sys:String x:Key="S_Tagline">Une image d'arrière-plan adaptée à chaque résolution d'écran(s)</sys:String>
  <sys:String x:Key="S_FolderLabel">Dossier des images</sys:String>
  <sys:String x:Key="S_BrowseLabel">Parcourir...</sys:String>
  <sys:String x:Key="S_PositionLabel">Affichage de l'image</sys:String>
  <sys:String x:Key="S_PosFill">Rempli (recadré si besoin)</sys:String>
  <sys:String x:Key="S_PosFit">Entier (bandes sur les côtés)</sys:String>
  <sys:String x:Key="S_PosStretch">Déformé pour remplir</sys:String>
  <sys:String x:Key="S_PosCenter">Centré, taille réelle</sys:String>
  <sys:String x:Key="S_PosTile">Répété en mosaïque</sys:String>
  <sys:String x:Key="S_PosSpan">Une seule image sur tous les écrans</sys:String>
  <sys:String x:Key="S_RefreshLabel">Actualiser</sys:String>
  <sys:String x:Key="S_ScreensHeading">Vos écrans</sys:String>
  <sys:String x:Key="S_PrimaryBadge">Écran principal</sys:String>
  <sys:String x:Key="S_AutoLabel">Revenir à l'automatique</sys:String>
  <sys:String x:Key="S_AutoToggle">Changer les fonds d'écran automatiquement</sys:String>
  <sys:String x:Key="S_AutoToggleTip">Quand c'est actif, les fonds d'écran se remettent en place tout seuls dès que vous branchez, débranchez ou changez d'écran, y compris après un redémarrage.</sys:String>
  <sys:String x:Key="S_ApplyLabel">Appliquer maintenant</sys:String>
  <sys:String x:Key="S_LogLabel">Voir le journal</sys:String>
  <sys:String x:Key="S_LogTip">Ouvre le fichier texte où l'outil note ce qu'il fait.</sys:String>
  <sys:String x:Key="S_ThemeName">Changer d'apparence</sys:String>
  <sys:String x:Key="S_AboutName">À propos de screen4screen</sys:String>
  <sys:String x:Key="S_AboutTip">Ce que ce programme fait sur votre ordinateur</sys:String>
  <sys:String x:Key="S_LangName">Changer de langue</sys:String>
  <sys:String x:Key="S_LangTip">Choisir la langue de la fenêtre</sys:String>
  <sys:String x:Key="S_AboutTitle">Ce que fait ce programme</sys:String>
  <sys:String x:Key="S_AboutIntro">Chaque écran reçoit une image faite pour sa résolution, et les fonds se remettent en place quand vous changez d'écran.</sys:String>
  <sys:String x:Key="S_AboutChangesHeading">Ce qu'il modifie</sys:String>
  <sys:String x:Key="S_AboutChanges1">Votre fond d'écran, et rien d'autre dans vos réglages d'affichage.</sys:String>
  <sys:String x:Key="S_AboutChanges2">Avec le changement automatique activé : une tâche planifiée nommée screen4screen, lancée à votre ouverture de session, sous votre compte et sans droits administrateur. La désactiver la supprime.</sys:String>
  <sys:String x:Key="S_AboutFilesIntro">Trois fichiers, tous supprimables :</sys:String>
  <sys:String x:Key="S_AboutFile3">wallpapers.json, dans votre dossier d'images</sys:String>
  <sys:String x:Key="S_AboutNotHeading">Ce qu'il ne fait pas</sys:String>
  <sys:String x:Key="S_AboutNot1">Aucune connexion à Internet, aucune donnée envoyée.</sys:String>
  <sys:String x:Key="S_AboutNot2">Vos images sont seulement lues, jamais modifiées ni déplacées.</sys:String>
  <sys:String x:Key="S_AboutNot3">Rien n'est installé, et rien n'est écrit hors de votre compte.</sys:String>
  <sys:String x:Key="S_AboutSpotlightHeading">Si les fonds reviennent tout seuls</sys:String>
  <sys:String x:Key="S_AboutSpotlight">Désactivez Windows Spotlight et le diaporama dans Paramètres, Personnalisation, Arrière-plan.</sys:String>
  <sys:String x:Key="S_ShowTaskLabel">Voir la tâche dans Windows</sys:String>
  <sys:String x:Key="S_ShowTaskTip">Ouvre le Planificateur de tâches de Windows, où la tâche screen4screen peut être inspectée ou supprimée à la main.</sys:String>
  <sys:String x:Key="S_GithubTip">Ouvrir la page du projet dans votre navigateur</sys:String>
  <sys:String x:Key="S_CloseLabel">Fermer</sys:String>
  <sys:String x:Key="S_Version">Version {0}</sys:String>

</ResourceDictionary>
