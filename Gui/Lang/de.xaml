<?xml version="1.0" encoding="utf-8"?>
<!-- German strings for the screen4screen window.

     Every user-facing string lives in one of these files, never in the code.
     The window merges the chosen one into its resources and refers to each
     string with {DynamicResource}, so switching language re-renders the
     window in place. Keep the keys identical across all four files: the
     window falls back to English for a key that is missing.

     UTF-8, and the XML declaration above says so, which is why accented text
     is safe here and not in the .ps1 files. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <sys:String x:Key="S_Applying">Wird angewendet...</sys:String>
  <sys:String x:Key="S_Applied">{0} Bildschirm(e) aktualisiert.</sys:String>
  <sys:String x:Key="S_AppliedPartial">{0} von {1} Bildschirm(en) aktualisiert. Einzelheiten im Protokoll.</sys:String>
  <sys:String x:Key="S_Saved">Einstellungen gespeichert.</sys:String>
  <sys:String x:Key="S_TopologyChanged">Ihre Bildschirme haben sich geändert, die Liste ist aktuell.</sys:String>
  <sys:String x:Key="S_TopologyChangedIdle">Ihre Bildschirme haben sich geändert. Klicken Sie auf „Jetzt anwenden“.</sys:String>
  <sys:String x:Key="S_FolderMissing">Diesen Ordner gibt es nicht.</sys:String>
  <sys:String x:Key="S_NoDisplay">Kein Bildschirm erkannt. Versuchen Sie „Aktualisieren“.</sys:String>
  <sys:String x:Key="S_AutoOn">Aktiv: Ihre Hintergrundbilder folgen Ihren Bildschirmen.</sys:String>
  <sys:String x:Key="S_AutoOff">Inaktiv: Die Hintergrundbilder wechseln nicht mehr von selbst.</sys:String>
  <sys:String x:Key="S_AutoPaused">Pausiert: Es geht bei Ihrer nächsten Anmeldung weiter.</sys:String>
  <sys:String x:Key="S_AutoFailed">Diese Einstellung liess sich nicht ändern. Einzelheiten im Protokoll.</sys:String>
  <sys:String x:Key="S_Error">Es ist ein Fehler aufgetreten. Einzelheiten im Protokoll.</sys:String>
  <sys:String x:Key="S_PickTitle">Wählen Sie ein Bild für diesen Bildschirm</sys:String>
  <sys:String x:Key="S_BrowseTitle">Wählen Sie den Ordner mit Ihren Bildern.</sys:String>
  <sys:String x:Key="S_SourceAuto">(automatisch gewählt)</sys:String>
  <sys:String x:Key="S_SourceManual">(Ihre Wahl)</sys:String>
  <sys:String x:Key="S_NoImage">Kein Bild passt zu diesem Bildschirm.</sys:String>
  <sys:String x:Key="S_NoThumb">Für dieses Bildformat ist keine Vorschau möglich.</sys:String>
  <sys:String x:Key="S_NotMatched">Windows kann diesen Bildschirm nicht unterscheiden; das Bild wird überall angewendet.</sys:String>
  <sys:String x:Key="S_PickLabel">Bild wählen...</sys:String>
  <sys:String x:Key="S_ChangeLabel">Ändern...</sys:String>
  <sys:String x:Key="S_LoadingPreviews">Vorschauen werden geladen...</sys:String>
  <sys:String x:Key="S_Working">Einen Moment...</sys:String>
  <sys:String x:Key="S_ThemeToDark">Zum dunklen Erscheinungsbild wechseln</sys:String>
  <sys:String x:Key="S_ThemeToLight">Zum hellen Erscheinungsbild wechseln</sys:String>
  <sys:String x:Key="S_Tagline">Ein Hintergrundbild, passend zu jeder Bildschirmauflösung</sys:String>
  <sys:String x:Key="S_FolderLabel">Bilderordner</sys:String>
  <sys:String x:Key="S_BrowseLabel">Durchsuchen...</sys:String>
  <sys:String x:Key="S_PositionLabel">Darstellung des Bildes</sys:String>
  <sys:String x:Key="S_PosFill">Ausgefüllt (bei Bedarf beschnitten)</sys:String>
  <sys:String x:Key="S_PosFit">Ganzes Bild (Balken an den Seiten)</sys:String>
  <sys:String x:Key="S_PosStretch">Verzerrt ausgefüllt</sys:String>
  <sys:String x:Key="S_PosCenter">Zentriert, Originalgrösse</sys:String>
  <sys:String x:Key="S_PosTile">Gekachelt</sys:String>
  <sys:String x:Key="S_PosSpan">Ein Bild über alle Bildschirme</sys:String>
  <sys:String x:Key="S_RefreshLabel">Aktualisieren</sys:String>
  <sys:String x:Key="S_ScreensHeading">Ihre Bildschirme</sys:String>
  <sys:String x:Key="S_PrimaryBadge">Hauptbildschirm</sys:String>
  <sys:String x:Key="S_AutoLabel">Zurück zu automatisch</sys:String>
  <sys:String x:Key="S_AutoToggle">Hintergrundbilder automatisch wechseln</sys:String>
  <sys:String x:Key="S_AutoToggleTip">Wenn dies aktiv ist, setzen sich die Hintergrundbilder von selbst wieder, sobald Sie einen Bildschirm anschliessen, trennen oder wechseln, auch nach einem Neustart.</sys:String>
  <sys:String x:Key="S_ApplyLabel">Jetzt anwenden</sys:String>
  <sys:String x:Key="S_LogLabel">Protokoll ansehen</sys:String>
  <sys:String x:Key="S_LogTip">Öffnet die Textdatei, in der das Programm notiert, was es tut.</sys:String>
  <sys:String x:Key="S_ThemeName">Erscheinungsbild wechseln</sys:String>
  <sys:String x:Key="S_AboutName">Über screen4screen</sys:String>
  <sys:String x:Key="S_AboutTip">Was dieses Programm auf Ihrem Computer tut</sys:String>
  <sys:String x:Key="S_LangName">Sprache wechseln</sys:String>
  <sys:String x:Key="S_LangTip">Sprache dieses Fensters wählen</sys:String>
  <sys:String x:Key="S_AboutTitle">Was dieses Programm tut</sys:String>
  <sys:String x:Key="S_AboutIntro">Jeder Bildschirm erhält ein Bild, das für seine Auflösung gemacht ist, und die Hintergrundbilder setzen sich wieder, wenn Sie den Bildschirm wechseln.</sys:String>
  <sys:String x:Key="S_AboutChangesHeading">Was es ändert</sys:String>
  <sys:String x:Key="S_AboutChanges1">Ihr Hintergrundbild, und sonst nichts an Ihren Anzeigeeinstellungen.</sys:String>
  <sys:String x:Key="S_AboutChanges2">Bei aktiviertem automatischem Wechsel: eine geplante Aufgabe namens screen4screen, gestartet bei Ihrer Anmeldung, unter Ihrem Konto und ohne Administratorrechte. Das Ausschalten entfernt sie.</sys:String>
  <sys:String x:Key="S_AboutFilesIntro">Drei Dateien, alle löschbar:</sys:String>
  <sys:String x:Key="S_AboutFile3">wallpapers.json, in Ihrem Bilderordner</sys:String>
  <sys:String x:Key="S_AboutNotHeading">Was es nicht tut</sys:String>
  <sys:String x:Key="S_AboutNot1">Keine Verbindung zum Internet, keine Daten werden gesendet.</sys:String>
  <sys:String x:Key="S_AboutNot2">Ihre Bilder werden nur gelesen, nie geändert oder verschoben.</sys:String>
  <sys:String x:Key="S_AboutNot3">Es wird nichts installiert und nichts ausserhalb Ihres Kontos geschrieben.</sys:String>
  <sys:String x:Key="S_AboutSpotlightHeading">Wenn die Hintergrundbilder von selbst zurückkommen</sys:String>
  <sys:String x:Key="S_AboutSpotlight">Schalten Sie Windows Spotlight und die Diaschau unter Einstellungen, Personalisierung, Hintergrund aus.</sys:String>
  <sys:String x:Key="S_ShowTaskLabel">Aufgabe in Windows anzeigen</sys:String>
  <sys:String x:Key="S_ShowTaskTip">Öffnet die Windows-Aufgabenplanung, wo die Aufgabe screen4screen angesehen oder von Hand entfernt werden kann.</sys:String>
  <sys:String x:Key="S_GithubTip">Die Projektseite im Browser öffnen</sys:String>
  <sys:String x:Key="S_CloseLabel">Schliessen</sys:String>
  <sys:String x:Key="S_Version">Version {0}</sys:String>

</ResourceDictionary>
