# The default image folder. Only the three ISC sample backgrounds are
# tracked; anything you drop in here stays yours.
wallpapers/*
!wallpapers/README.md
!wallpapers/5120x2160.webp
!wallpapers/ratio-16x9.webp
!wallpapers/default.webp

# Per-user manual monitor assignments, written next to the images
wallpapers.json

# PowerShell / editor leftovers
*.log
*.swp
.vscode/
.idea/
Thumbs.db
desktop.ini

# Pester / analyzer output (future)
TestResults/
coverage.xml

# Built launcher (run build/Build-Launcher.ps1 to produce it)
screen4screen.exe
