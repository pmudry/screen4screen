root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psm1,psd1}]
end_of_line = crlf

# .gitattributes stores these with CRLF too; without this an editor on WSL
# would write LF into the working tree.
[*.{cs,cmd}]
end_of_line = crlf

[*.xaml]
indent_size = 2
end_of_line = crlf

[*.md]
indent_size = 2
end_of_line = lf
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
